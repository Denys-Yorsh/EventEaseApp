@page "/"
@using EventEaseApp.Models
@using EventEaseApp.Components

<h1>Добро пожаловать в EventEase</h1>

<div class="row">
    <div class="col-md-6">
        <h3>Управление событием</h3>
        <EventCard @bind-Event="myEvent" />
    </div>
    
    <div class="col-md-6">
        <h3>Регистрация на событие</h3>
        <RegistrationForm MaxCapacity="3" />
    </div>
</div>

@code {
    private EventModel myEvent = new EventModel
    {
        Id = 1,
        Title = "Tech Conference 2026",
        Description = "Ежегодная IT конференция"
    };
}